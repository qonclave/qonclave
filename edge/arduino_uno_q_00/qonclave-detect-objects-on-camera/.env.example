# Copy this file to .env and edit as needed. .env is gitignored; this file is
# the tracked template. Every var here is optional — main.py falls back to
# its own default when a var is unset.

# --- Web UI login ----------------------------------------------------------
# Both must be set or the Web UI (port 7000) runs unauthenticated.
# WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD=qonclave

# --- Camera source: usb | ip | file --------------------------------------
CAMERA_SOURCE=file

# usb mode
# USB_CAMERA_DEVICE=/dev/video0

# ip mode (Android "IP Webcam" app or similar)
# IP_CAMERA_URL=http://192.168.18.65:8080/video
# IP_CAMERA_USERNAME=
# IP_CAMERA_PASSWORD=
# IP_CAMERA_FPS=10

# file mode (loops a local video file, no hardware needed)
VIDEO_FILE_PATH=/app/media/sample.mp4
VIDEO_FILE_LOOP=true
VIDEO_FILE_FPS=10

# --- Qonclave hub event forwarding ----------------------------------------
# DEVICE_ID=unoq-01
# HUB_MDNS_NAME=qonclave-hub.local
# HUB_IP=192.168.50.207
# HUB_PORT=8000
# PERSON_CONFIDENCE_THRESHOLD=0.7
# HUB_EVENT_HYSTERESIS_SEC=10
# HUB_EVENT_TIMEOUT_SEC=5
# ESCALATION_DIR=/app/escalations
# ESCALATION_MAX_FILES=100

# --- Person tracking (cross-frame ID + direction) -------------------------
# PERSON_TRACK_MAX_DISAPPEARED=10
# PERSON_TRACK_MAX_DISTANCE_PX=150
# PERSON_TRACK_DIRECTION_HISTORY=5
# PERSON_TRACK_MIN_MOVEMENT_PX=10
# CAMERA_DUAL_LENS_STACKED = 1

# --- Hub->edge command channel (MQTT) -------------------------------------
# The broker runs on the hub machine; MQTT_HOST defaults to HUB_IP when unset.
# EDGE_MQTT_ENABLED=1
# MQTT_HOST=192.168.50.207
# MQTT_PORT=1883
