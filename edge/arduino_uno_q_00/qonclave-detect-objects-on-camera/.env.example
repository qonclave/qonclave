# Copy this file to .env and edit as needed. .env is gitignored; this file is
# the tracked template. Every var here is optional — main.py falls back to
# its own default when a var is unset.

# --- Web UI login ----------------------------------------------------------
# Both must be set or the Web UI (port 7000) runs unauthenticated.
# WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD=qonclave

# --- Camera source: usb | ip | file --------------------------------------
CAMERA_SOURCE=file

# usb mode
# USB_CAMERA_DEVICE=/dev/video0

# ip mode (Android "IP Webcam" app or similar)
# IP_CAMERA_URL=http://192.168.18.65:8080/video
# IP_CAMERA_USERNAME=
# IP_CAMERA_PASSWORD=
# IP_CAMERA_FPS=10

# file mode (loops a local video file, no hardware needed)
VIDEO_FILE_PATH=/app/media/sample.mp4
VIDEO_FILE_LOOP=true
VIDEO_FILE_FPS=10

# --- Qonclave hub event forwarding ----------------------------------------
# DEVICE_ID=unoq-01
# Automatic mDNS/UDP discovery is disabled by default; set to 1 to enable it.
# HUB_DISCOVERY_ENABLED=0
# HUB_MDNS_NAME=qonclave-hub.local
# HUB_IP=192.168.18.62
# HUB_PORT=8000
# Spec ingest path (spec/v1/openapi/hub.yaml). Point back at /edge/event for a
# hub that has not been updated to serve the /api/v1 surface.
# HUB_EVENTS_PATH=/api/v1/events
# HUB_EVENT_TIMEOUT_SEC=5
# ESCALATION_DIR=/app/escalations
# ESCALATION_MAX_FILES=100

# --- Placement: where a detection gets verified (python/placement.py) ------
# Escalate to the hub above this local confidence. Inclusive-stay: a detection
# exactly at the threshold stays on the edge.
# PERSON_CONFIDENCE_THRESHOLD=0.7
# Minimum seconds between two escalations, so one person walking past does not
# generate a burst.
# HUB_EVENT_HYSTERESIS_SEC=10
# How long a verification answer stays useful. Travels with the event as
# task.remaining_ms, so the hub knows how much budget is left rather than
# re-planning against the original deadline.
# HUB_EVENT_DEADLINE_MS=3000
# Below this battery percentage, keep the local verdict rather than spending
# radio. Unset by default — this deployment is mains-powered.
# ESCALATION_BATTERY_FLOOR_PCT=20

# --- Person tracking (cross-frame ID + direction) -------------------------
# PERSON_TRACK_MAX_DISAPPEARED=10
# PERSON_TRACK_MAX_DISTANCE_PX=150
# PERSON_TRACK_DIRECTION_HISTORY=5
# PERSON_TRACK_MIN_MOVEMENT_PX=10
# CAMERA_DUAL_LENS_STACKED = 1
# Horizontal bearing calibration. Normal cameras use the pinhole FOV; stacked
# front/rear fisheye cameras use the per-lens FOV.
CAMERA_HORIZONTAL_FOV_DEGREES=70
CAMERA_DUAL_LENS_FOV_DEGREES=180

# Automatically rotate until the tracked person is within the center tolerance.
PERSON_AUTO_CENTER_ENABLED=1
PERSON_CENTER_TOLERANCE_DEGREES=3
PERSON_CENTER_MAX_TURN_DEGREES=90
PERSON_CENTER_MIN_INTERVAL_SEC=0.75
PERSON_CENTER_ESTIMATED_MS_PER_DEGREE=12
PERSON_CENTER_SETTLE_SEC=0.35

# --- Hub->edge command channel (MQTT) -------------------------------------
# The broker runs on the hub machine; MQTT_HOST defaults to HUB_IP when unset.
# EDGE_MQTT_ENABLED=1
# MQTT_HOST=192.168.18.62
# MQTT_PORT=1883

# --- Per-track analysis (POST /track/analyze) -----------------------------
# Samples each tracked person's crop to the hub, which fans it out to whichever
# analyzers are due. Independent of the LED display / auto-centering above.
# TRACK_RECOGNITION_ENABLED=1
# Which analyzers to ask for. Drop "pose" on a hub with no pose model to stop
# paying for a request that can only answer "unavailable".
# TRACK_ANALYZERS=face,pose
# TRACK_CROP_PADDING=0.25
# Larger than TRACK_CROP_PADDING because a face sits right at the top of a
# person box. This is why the crop needs a person_box: the padding is
# face-tuned, so the person fills only about half of it, and pose re-frames
# from the rect the edge sends alongside.
# TRACK_CROP_PADDING_TOP=0.8
# TRACK_CROPS_DIR=/app/track_crops
#
# Per-analyzer sampling cadence. Face stops once a track is known — identity
# does not change. Pose keeps going for as long as the track is alive, because
# fall detection needs a continuous time series rather than a single answer.
# RECOGNITION_SAMPLE_INTERVAL_SEC=1.0
# POSE_SAMPLE_INTERVAL_SEC=0.25
# RECOGNITION_REQUEST_TIMEOUT_SEC=5
#
# Crop rejection thresholds are no longer configurable here: they are per
# analyzer now (face 40px/0.85, pose 100px/0.5) and live in python/track_crop.py.
# A single pair could not serve both — 0.85 silently drops a person who has
# fallen near the frame edge, which is the event pose exists to catch.
