# Secrets — never commit
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
geniex-env/
venv/
.venv/
env/

# Models / large artifacts
*.tflite
*.onnx
*.bin
*.gguf
# Exclude the CONTENTS, not the directory itself: git never descends into an
# excluded directory, so "models/" would make the negation below dead - the
# README stays tracked only because it predates the rule, and could not be
# re-added after a `git rm --cached`.
# "**/" because a pattern with an internal slash is anchored to this file's
# directory - plain "models/*" would only match <repo>/models/, not the one
# nested under hub/framework/face_id/.
**/models/*
!examples/hub/framework/face_id/models/README.txt
!examples/hub/framework/pose/models/README.txt


# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs / temp
*.log
tmp/
*.tmp

# Enrolled face photos + embedding cache are per-deployment data -- never
# committed here, regardless of layout (flat <name>.jpg or one directory
# per person). Excludes the CONTENTS, not the directory itself, so the
# negated exception below can still track the format-explainer README.
examples/hub/framework/face_id/known_faces/*
!examples/hub/framework/face_id/known_faces/README.txt

# Hub runtime uploads (camera frames received from edge devices)
examples/hub/uploads/

# Annotated per-track frames written by /track/analyze (gated by
# QONCLAVE_TRACK_FRAMES_ENABLED). Imagery persisting on the hub is exactly
# what the privacy cascade otherwise avoids, so this is never committed.
examples/hub/track_frames/

# Hub runtime-generated icon cache + VLM placeholder image
examples/hub/icons_cache.json
examples/hub/scratch_blank.jpg

# Hub per-deployment known-person follow priorities (dashboard-edited runtime state)
examples/hub/apps/security/known_person_priorities.json

# Edge escalation frames saved locally on threshold-triggered detections
examples/edge/**/escalations/

# Edge per-track person crops (track_crop.save_crop_locally). Regenerated at
# runtime and overwritten per track_id — and they are photographs of whoever
# walked past the camera, so they must not end up in the repo.
examples/edge/**/track_crops/

# One-off backups taken on-device before deploying a change
*.bak-pre-*

# Arduino App Lab build output
.cache/

# C conformance emits interop artifacts here; Python decodes them. Build output, not source.
framework/conformance/generated/*
!framework/conformance/generated/.gitkeep
.claude/
.gemini/
.obsidian/
QUAD/
