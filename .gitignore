# Secrets — never commit
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
geniex-env/
venv/
.venv/
env/

# Models / large artifacts
*.tflite
*.onnx
*.bin
*.gguf
# Exclude the CONTENTS, not the directory itself: git never descends into an
# excluded directory, so "models/" would make the negation below dead - the
# README stays tracked only because it predates the rule, and could not be
# re-added after a `git rm --cached`.
# "**/" because a pattern with an internal slash is anchored to this file's
# directory - plain "models/*" would only match <repo>/models/, not the one
# nested under hub/framework/face_id/.
**/models/*
!hub/framework/face_id/models/README.txt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs / temp
*.log
tmp/
*.tmp

# Face ID embedding cache
hub/framework/face_id/known_faces/.embeddings_*.npy

# Hub runtime uploads (camera frames received from edge devices)
hub/uploads/

# Arduino App Lab build output
.cache/
