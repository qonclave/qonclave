# Copy this file to .env and fill in real values. Do NOT commit .env.

# GitHub push URL (token-embedded). Keep secret.
GIT_REMOTE_URL=https://<token>@github.com/jogendar/Qonclave.git

# GitHub personal access token
GITHUB_TOKEN=<your_token_here>

# Twilio SMS notifications (hub/framework/sms_bus.py)
# Trial mode: a fixed template is sent to a fixed number regardless of
# the Notification fields — these credentials just activate the channel.
TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
QONCLAVE_SMS_ENABLED=1
