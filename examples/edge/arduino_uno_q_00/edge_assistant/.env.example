# Edge Assistant — Environment Variables

# ── Test mode (no hub required) ────────────────────────────────────────────
# EDGE_TEST_MODE=0    # set to 1 to skip the hub entirely; VOSK transcription
#                     # is echoed back via piper-tts to test the STT→TTS path

# ── Audio source ───────────────────────────────────────────────────────────
# AUDIO_SOURCE=mic         # live USB microphone (default)
# AUDIO_SOURCE=file        # replay a .wav file (no looping; for testing)
# AUDIO_FILE_PATH=/app/media/sample.wav   # path to test .wav (file mode only)

# ── Device identity ────────────────────────────────────────────────────────
# DEVICE_ID=unoq-01

# ── Hub connection ─────────────────────────────────────────────────────────
# HUB_IP=192.168.18.62
# HUB_PORT=8000
# HUB_TIMEOUT_SEC=30          # max seconds to wait for LLM response
# HUB_DISCOVERY_ENABLED=0     # set to 1 to enable mDNS/UDP hub discovery
# HUB_MDNS_NAME=qonclave-hub.local

# ── Wake word & STT ────────────────────────────────────────────────────────
# WAKE_WORD=conclave
# SILENCE_TIMEOUT_SEC=2.5     # seconds of silence to end utterance
# SAMPLE_RATE=16000
# VOSK_MODEL_PATH=/app/models/vosk-model-en-us-0.22-lgraph

# ── TTS ────────────────────────────────────────────────────────────────────
# PIPER_MODEL_DIR=/app/models/piper
# PIPER_VOICE=en_US-lessac-medium
