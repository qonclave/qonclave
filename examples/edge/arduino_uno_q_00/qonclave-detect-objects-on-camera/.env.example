# Copy this file to .env and edit as needed. .env is gitignored; this file is
# the tracked template. Every var here is optional — main.py falls back to
# its own default when a var is unset.

# --- Web UI login ----------------------------------------------------------
# Both must be set or the Web UI (port 7000) runs unauthenticated.
# WEB_UI_USERNAME=admin
# WEB_UI_PASSWORD=qonclave

# --- Camera source: usb | ip | file --------------------------------------
CAMERA_SOURCE=file

# usb mode
# USB_CAMERA_DEVICE=/dev/video0

# ip mode (Android "IP Webcam" app or similar)
# IP_CAMERA_URL=http://192.168.18.65:8080/video
# IP_CAMERA_USERNAME=
# IP_CAMERA_PASSWORD=
# IP_CAMERA_FPS=10

# file mode (loops a local video file, no hardware needed)
VIDEO_FILE_PATH=/app/media/walking_front_view.mp4
VIDEO_FILE_LOOP=true
VIDEO_FILE_FPS=25

# --- Live preview ----------------------------------------------------------
# The /track-preview stream runs at camera rate (detection only refreshes the
# overlay boxes); this caps its published fps to bound encode CPU + bandwidth.
# PREVIEW_MAX_FPS=15
# Frames/sec forwarded to the detection runner. It infers at ~1.5/s on this
# board but pays decode/re-encode/disk CPU for every frame it receives, so
# anything above the inference rate is wasted work. 0 disables the gate.
# RUNNER_MAX_FPS=3

# --- Qonclave hub event forwarding ----------------------------------------
# DEVICE_ID=unoq-01
# Automatic mDNS/UDP discovery is disabled by default; set to 1 to enable it.
# HUB_DISCOVERY_ENABLED=0
# HUB_MDNS_NAME=qonclave-hub.local
# HUB_IP=192.168.18.62
# HUB_PORT=8000
# Periodic ("reason about whatever is visible every N seconds") frames to the
# hub VLM are DISABLED. The VLM runs event-driven only: posture investigation,
# dashboard button, CAPTURE SMS. Interval frames competed with those for the
# same single-threaded VLM, so a real collapse could queue behind a routine
# frame that carried no posture context anyway.
#
# This switch is authoritative and overrides the interval knobs below, so a
# stale value here cannot silently re-enable the periodic path. To bring it
# back, set BOTH this to 1 and HUB_EVENT_INTERVAL_SEC to a positive value.
# HUB_PERIODIC_REASONING_ENABLED=0
# Auto-send person-detection frames to the hub (POST /edge/event -> hub VLM)
# at most once every HUB_EVENT_INTERVAL_SEC seconds. Ignored (forced to 0)
# while HUB_PERIODIC_REASONING_ENABLED is off.
# HUB_EVENT_INTERVAL_SEC=0
# Legacy pair, honored only when HUB_EVENT_INTERVAL_SEC is unset, and also
# subject to HUB_PERIODIC_REASONING_ENABLED above.
# HUB_EVENT_ENABLED=0
# HUB_EVENT_HYSTERESIS_SEC=10
# PERSON_CONFIDENCE_THRESHOLD=0.7
# HUB_EVENT_TIMEOUT_SEC=5
# ESCALATION_DIR=/app/escalations
# ESCALATION_MAX_FILES=100

# --- Person tracking (cross-frame ID + direction) -------------------------
# PERSON_TRACK_MAX_DISAPPEARED=10
# PERSON_TRACK_MAX_DISTANCE_PX=150
# PERSON_TRACK_DIRECTION_HISTORY=5
# PERSON_TRACK_MIN_MOVEMENT_PX=10
# CAMERA_DUAL_LENS_STACKED = 1
# Horizontal bearing calibration. Normal cameras use the pinhole FOV; stacked
# front/rear fisheye cameras use the per-lens FOV.
CAMERA_HORIZONTAL_FOV_DEGREES=70
CAMERA_DUAL_LENS_FOV_DEGREES=180

# Automatically rotate until the tracked person is within the center tolerance.
PERSON_AUTO_CENTER_ENABLED=1
PERSON_CENTER_TOLERANCE_DEGREES=3
PERSON_CENTER_MAX_TURN_DEGREES=90
PERSON_CENTER_MIN_INTERVAL_SEC=0.75
PERSON_CENTER_ESTIMATED_MS_PER_DEGREE=12
PERSON_CENTER_SETTLE_SEC=0.35
# Discard bearings measured within this window after any robot motion ends:
# the detection pipeline lags ~1s behind the camera, so frames captured while
# the robot was still turning keep arriving after it stops, and acting on
# their shifted bearings drives the turn/counter-turn ping-pong. Must be at
# least the frame-capture -> bearing latency; raise it if turns still chain.
PERSON_CENTER_POST_MOTION_BLANK_SEC=1.5
# Correct only this fraction of the measured error per turn (0.1-1.0). Under-
# shooting leaves the remainder for the next fresh bearing; overshooting
# reverses direction and can sustain a limit cycle. 1.0 disables damping.
PERSON_CENTER_TURN_GAIN=0.7

# --- Investigation approach (pre-capture close-up) -------------------------
# When the hub opens an investigation (posture went SUSPICIOUS/DANGER) it asks
# this device for one frame. Before capturing, the robot turns to face the
# tracked person and drives forward briefly, so the VLM reasons about a
# close-up instead of a distant smudge.
#
# The whole approach must finish inside the hub's capture timeout
# (QONCLAVE_INVESTIGATION_CAPTURE_TIMEOUT_SEC, 10s) or the hub gives up and
# uses a buffered crop -- discarding the frame this exists to produce. Steps
# that don't fit the budget are dropped, never shortened.
# INVESTIGATION_APPROACH_ENABLED=1
# Seconds of forward motion (the MCU's unit for FORWARD; integer, min 1).
# INVESTIGATION_APPROACH_FORWARD_SEC=1
# Skip the alignment turn when the target is already this close to center.
# INVESTIGATION_APPROACH_TOLERANCE_DEGREES=8
# Cap on the one-shot alignment turn, so a target far off to the side cannot
# spend the whole budget rotating and never get its close-up.
# INVESTIGATION_APPROACH_MAX_TURN_DEGREES=45
# Settle time after motion: lets the chassis stop rocking and the camera emit
# a frame from the new position, so the capture is sharp.
# INVESTIGATION_APPROACH_SETTLE_SEC=0.6
# INVESTIGATION_APPROACH_BUDGET_SEC=6
# A bearing older than this is not trusted to aim a turn (detection runs at
# ~1.5 Hz); the approach then drives forward without turning.
# INVESTIGATION_APPROACH_BEARING_MAX_AGE_SEC=3

# --- Known-person following ------------------------------------------------
# The robot prefers recognized people: it follows the visible known person
# with the lowest hub-stored priority number (1 = highest, set from the hub
# dashboard roster), holds for a grace period when that person briefly
# disappears instead of chasing an unknown, and only then falls back to the
# longest-established unknown track.
# Detection frames the known target may be missing before unknown fallback
# (~1.5 detection frames/sec on this board, so 10 frames is ~6.7 s).
# FOLLOW_KNOWN_GRACE_FRAMES=10
# How often the edge re-fetches the hub's priority map (also refreshed
# immediately when the hub comes back online).
# FOLLOW_PRIORITY_REFRESH_SEC=15
# FOLLOW_PRIORITY_TIMEOUT_SEC=3

# --- Hub->edge command channel (MQTT) -------------------------------------
# The broker runs on the hub machine; MQTT_HOST defaults to HUB_IP when unset.
# EDGE_MQTT_ENABLED=1
# MQTT_HOST=192.168.18.62
# MQTT_PORT=1883

# --- Per-track analysis (POST /track/analyze) ------------------------------
# Samples each tracked person's crop to the hub, fanned out to the requested
# analyzers: face identification (until known, then never again) and pose
# estimation (continuously, ~4 Hz, for fall detection). Independent of the
# LED display / auto-centering above.
# TRACK_RECOGNITION_ENABLED=1
# TRACK_ANALYZERS=face,pose
# TRACK_CROP_PADDING=0.25
# TRACK_CROP_PADDING_TOP=0.8
# TRACK_CROP_MIN_SIZE_PX=40
# TRACK_CROP_MIN_VISIBLE_RATIO=0.85
# TRACK_CROP_POSE_MIN_BOX_HEIGHT_PX=100
# TRACK_CROP_POSE_MIN_VISIBLE_RATIO=0.5
# TRACK_CROPS_DIR=/app/track_crops
# FACE_SAMPLE_INTERVAL_SEC=0.5
# POSE_SAMPLE_INTERVAL_SEC=0.25
# ANALYSIS_REQUEST_TIMEOUT_SEC=5
